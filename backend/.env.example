# Copy to .env and fill in for a real deployment. Everything here is optional
# for local dev — without a .env file the server generates a random JWT
# secret on first run (see backend/data/.jwt-secret) and Nova, the study
# tutor, answers from its built-in tutor (hints, steps, per-option
# explanations and skill strategies from the question bank).

PORT=4000

# Required for any real deployment. Without it, a random secret is generated
# and persisted locally, which is fine for dev but won't survive a fresh
# checkout/deploy and won't be shared across multiple server instances.
JWT_SECRET=

# ---- Where the app lives ----
# The public address of the website, e.g. https://prep.example.com (no trailing slash). Links in
# emails (password reset) are built from it, and it is allowed to call this API from a browser.
# Never taken from request headers. Required in production for emails to go out.
# APP_URL=https://prep.example.com

# Extra websites allowed to call this API from a browser, comma-separated. APP_URL is always allowed,
# and outside production so is the Vite dev server. Anything else gets no CORS headers.
# CORS_ORIGINS=https://prep.example.com,https://www.prep.example.com

# ---- Email (password-reset links) ----
# There is no mail server built in. Point this at a service that accepts POST { to, subject, text }
# as JSON. Without it no email is sent, and the "Forgot password" screen says so and sends students
# to their teacher for a temporary password.
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=

# ---- Nova (AI tutor) ----
# Optional: lets Nova (Ask Nova page + the practice player's chat) answer with
# Claude. TUTOR_MODEL defaults to claude-opus-5; TUTOR_EFFORT (low | medium |
# high) defaults to medium, which keeps chat replies quick.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5
TUTOR_EFFORT=medium
# Spending limits. When either is used up Nova carries on with the built-in tutor.
#   TUTOR_DAILY_PER_STUDENT  AI replies per student per day (default 30; 0 turns the AI off)
#   TUTOR_DAILY_TOTAL        AI replies per day across everyone (default 400)
#   TUTOR_MAX_TOKENS         ceiling for one reply, thinking included (default 1500)
# TUTOR_DAILY_PER_STUDENT=30
# TUTOR_DAILY_TOTAL=400
# TUTOR_MAX_TOKENS=1500

# ---- First-time setup (npm run seed) ----
# In production the seed script creates no default logins: set these, or it stops. The demo student
# ("Try the demo") is only created in production if SEED_DEMO=1; it is left out of leagues and stats.
# SEED_ADMIN_EMAIL=head@your-school.example
# SEED_ADMIN_PASSWORD=
# SEED_DEMO=1

# ---- Backups ----
# The database file is copied to data/backups/db-YYYY-MM-DD.json before the first write of each day,
# and the newest DB_BACKUP_KEEP (default 7) are kept. If db.json is ever unreadable, the damaged file
# is saved as db.json.unreadable-<time> and the newest valid backup is restored.
# DB_BACKUP_KEEP=7
# DB_BACKUP_DIR=/var/backups/northstar
# DB_BACKUPS=off

# Optional: timezone used for streaks, daily goals and the SAT countdown.
APP_TIMEZONE=Asia/Tashkent

# Optional: how many reverse proxies (nginx, a hosting platform's router) sit in front of this
# server. Needed behind one, or every student looks like the same visitor to the sign-in rate
# limits. Leave unset when the server is reached directly.
# TRUST_PROXY=1

# Optional: where uploaded files go (IELTS audio/images are stored in its ielts/ folder).
# UPLOAD_DIR=./uploads

# Optional: leave the question pack (backend/content/pack, about 1,650 questions) out of the bank.
# Its questions already in the database are hidden while this is set, not deleted.
# QUESTION_PACK=off
